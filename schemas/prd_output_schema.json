{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRDOutput",
  "description": "Schema de saída do PRD gerado pela App Factory",
  "type": "object",
  "required": [
    "prd_id",
    "app_name",
    "objective",
    "scope_in",
    "scope_out",
    "acceptance_criteria",
    "risks",
    "success_metrics",
    "quality_score"
  ],
  "properties": {
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[0-9]{4}-[A-Z0-9]+$"
    },
    "app_name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEW",
        "APPROVED",
        "REJECTED"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 20,
      "description": "Objetivo em 1 frase clara"
    },
    "target_user": {
      "type": "string"
    },
    "problem_statement": {
      "type": "string",
      "minLength": 50
    },
    "scope_in": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "scope_out": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Anti-goals"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "criterion",
          "measurable",
          "test_case"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "criterion": {
            "type": "string"
          },
          "measurable": {
            "type": "boolean"
          },
          "test_case": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "risk",
          "severity",
          "mitigation"
        ],
        "properties": {
          "risk": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "success_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "metric",
          "target",
          "measurement_method"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "measurement_method": {
            "type": "string"
          }
        }
      }
    },
    "quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "gate_status": {
      "type": "string",
      "enum": [
        "PASSED",
        "FAILED",
        "WARN"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}