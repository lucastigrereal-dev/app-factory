<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${app_name}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>body{font-family:'Inter',sans-serif;}</style>
</head>
<body class="bg-gray-50 text-gray-800">
  <div class="min-h-screen flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-gray-900 text-white p-6 hidden md:block">
      <h1 class="text-xl font-bold mb-8">${app_name}</h1>
      <nav class="space-y-2">
        ${nav_items}
      </nav>
    </aside>
    <!-- Main -->
    <main class="flex-1 p-6">
      <header class="flex justify-between items-center mb-8">
        <h2 class="text-2xl font-bold">Dashboard</h2>
        <span class="text-sm text-gray-500">${app_name} v1.0</span>
      </header>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        ${cards}
      </div>
      <div class="bg-white rounded-xl shadow p-6">
        <h3 class="font-bold mb-4">${table_title}</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead><tr class="border-b">${table_headers}</tr></thead>
            <tbody id="table-body">
              <!-- JS popula -->
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
  <script>
    const mockData = ${mock_data};
    const tbody = document.getElementById('table-body');
    mockData.forEach(item => {
      const tr = document.createElement('tr');
      tr.className = 'border-b hover:bg-gray-50';
      tr.innerHTML = Object.values(item).map(v => `<td class="py-2">${v}</td>`).join('');
      tbody.appendChild(tr);
    });
  </script>
</body>
</html>