<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${app_name}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>body{font-family:'Inter',sans-serif;}</style>
</head>
<body class="bg-gray-50 text-gray-800">
  <div class="min-h-screen flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-gray-900 text-white p-6 hidden md:block">
      <h1 class="text-xl font-bold mb-8">${app_name}</h1>
      <nav class="space-y-2">${nav_items}</nav>
      <div class="mt-auto pt-8 border-t border-gray-700">
        <div id="user-info" class="text-sm text-gray-400">Não logado</div>
      </div>
    </aside>
    <!-- Main -->
    <main class="flex-1 p-6">
      <header class="flex justify-between items-center mb-8">
        <h2 class="text-2xl font-bold">Dashboard</h2>
        <div class="flex gap-3">
          <button id="btn-login" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Login</button>
          <button id="btn-logout" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 hidden">Sair</button>
        </div>
      </header>
      <div id="auth-panel" class="hidden bg-white rounded-xl shadow p-6 mb-8 max-w-md">
        <h3 class="font-bold mb-4">Autenticação</h3>
        <div class="space-y-3">
          <input id="auth-user" type="text" placeholder="Usuário" class="w-full border rounded px-3 py-2">
          <input id="auth-pass" type="password" placeholder="Senha" class="w-full border rounded px-3 py-2">
          <div class="flex gap-2">
            <button id="btn-register" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">Registrar</button>
            <button id="btn-do-login" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Entrar</button>
          </div>
          <p id="auth-msg" class="text-sm text-red-600"></p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">${cards}</div>
      <div class="bg-white rounded-xl shadow p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="font-bold">${table_title}</h3>
          <button id="btn-refresh" class="px-3 py-1 bg-gray-100 rounded hover:bg-gray-200 text-sm">Atualizar</button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead><tr class="border-b">${table_headers}</tr></thead>
            <tbody id="table-body"><!-- JS popula --></tbody>
          </table>
        </div>
        <div id="api-status" class="mt-4 text-xs text-gray-500"></div>
      </div>
    </main>
  </div>
  <script>
    const API_BASE = window.API_BASE || 'http://localhost:8000';
    let token = localStorage.getItem('token') || '';

    function setStatus(msg) { document.getElementById('api-status').textContent = msg; }
    function authHeaders() { return token ? { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' }; }

    async function apiGet(path) {
      try { const r = await fetch(API_BASE + path, { headers: authHeaders() }); return r.ok ? await r.json() : null; } catch(e) { return null; }
    }

    async function loadItems() {
      const data = await apiGet('/api/${first_entity}');
      const tbody = document.getElementById('table-body');
      if (!data) {
        // Fallback mock (API offline)
        const mock = ${mock_data};
        setStatus('API offline — usando mock data');
        renderRows(mock);
        return;
      }
      setStatus('Conectado à API');
      renderRows(data);
    }

    function renderRows(rows) {
      const tbody = document.getElementById('table-body');
      tbody.innerHTML = '';
      rows.forEach(item => {
        const tr = document.createElement('tr'); tr.className = 'border-b hover:bg-gray-50';
        tr.innerHTML = Object.values(item).map(v => `<td class="py-2">${v}</td>`).join('');
        tbody.appendChild(tr);
      });
    }

    document.getElementById('btn-login').addEventListener('click', () => {
      document.getElementById('auth-panel').classList.toggle('hidden');
    });
    document.getElementById('btn-do-login').addEventListener('click', async () => {
      const u = document.getElementById('auth-user').value, p = document.getElementById('auth-pass').value;
      const body = new URLSearchParams(); body.append('username', u); body.append('password', p);
      const r = await fetch(API_BASE + '/auth/login', { method: 'POST', body });
      if (!r.ok) { document.getElementById('auth-msg').textContent = 'Login falhou'; return; }
      const data = await r.json(); token = data.access_token; localStorage.setItem('token', token);
      document.getElementById('auth-panel').classList.add('hidden');
      document.getElementById('btn-login').classList.add('hidden');
      document.getElementById('btn-logout').classList.remove('hidden');
      document.getElementById('user-info').textContent = u;
      loadItems();
    });
    document.getElementById('btn-register').addEventListener('click', async () => {
      const u = document.getElementById('auth-user').value, p = document.getElementById('auth-pass').value;
      const r = await fetch(API_BASE + '/auth/register', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: u, password: p }) });
      document.getElementById('auth-msg').textContent = r.ok ? 'Registrado! Faça login.' : 'Erro no registro';
    });
    document.getElementById('btn-logout').addEventListener('click', () => {
      token = ''; localStorage.removeItem('token');
      document.getElementById('btn-login').classList.remove('hidden');
      document.getElementById('btn-logout').classList.add('hidden');
      document.getElementById('user-info').textContent = 'Não logado';
      loadItems();
    });
    document.getElementById('btn-refresh').addEventListener('click', loadItems);

    // Init
    if (token) { document.getElementById('btn-login').classList.add('hidden'); document.getElementById('btn-logout').classList.remove('hidden'); }
    loadItems();
  </script>
</body>
</html>
